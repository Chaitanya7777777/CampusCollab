APP_ENV=development
DATABASE_URL=postgresql+asyncpg://campuscollab:local_dev_only@127.0.0.1:5432/campuscollab
# Replace with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CSRF_SECRET=replace-with-a-random-secret-at-least-32-characters
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
SESSION_TTL_SECONDS=604800
CSRF_TTL_SECONDS=3600
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Links use this explicit origin, never the incoming Host header.
FRONTEND_BASE_URL=http://localhost:3000
RESET_TTL_SECONDS=1800
VERIFICATION_TTL_SECONDS=86400
SIGNUP_CODE_TTL_SECONDS=600
SIGNUP_CODE_ATTEMPTS=5
SIGNUP_RESEND_COOLDOWN_SECONDS=60
# Explicit selection: smtp (local Mailpit) or brevo (HTTPS transactional API).
EMAIL_PROVIDER=smtp
# Fill these privately only when selecting brevo; never use NEXT_PUBLIC variables.
# BREVO_API_KEY=replace-with-your-private-brevo-api-key
# BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=CampusCollab
BREVO_TIMEOUT_SECONDS=5
# Local Mailpit; production SMTP needs an authorized sender and TLS.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=CampusCollab <noreply@campuscollab.local>
SMTP_TLS=none
SMTP_TIMEOUT_SECONDS=5
# SMTP_USERNAME and SMTP_PASSWORD belong only in your private environment.
# Run Uvicorn with --no-proxy-headers. Trust no forwarded addresses by default.
TRUSTED_PROXY_NETWORKS=[]
RATE_WINDOW_SECONDS=900
RATE_IP_LIMIT=300
RATE_LOGIN_LIMIT=10
RATE_SIGNUP_LIMIT=5
RATE_EMAIL_LIMIT=3
RATE_TOKEN_LIMIT=10
# Only used explicitly by tests; this is a SEPARATE database and role.
TEST_DATABASE_URL=postgresql+asyncpg://campuscollab_test:local_test_only@127.0.0.1:5433/campuscollab_test
