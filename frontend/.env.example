# Choose mock (local prototype) or api (real accounts, projects, applications and teams).
NEXT_PUBLIC_APP_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Hosted API mode uses /api/v1, never the Render origin in the public variable.
# Server-only forwarding settings (fill privately, not NEXT_PUBLIC):
# APP_ORIGIN=https://your-project.vercel.app
# API_BACKEND_ORIGIN=https://your-api.onrender.com
# API_PROXY_SECRET=replace-with-a-random-shared-secret
# Local forwarding only: API_PROXY_LOCAL=true, both origins must use loopback HTTP.
